### Health
GET {{host}}/health

###
# Auth - generic register (defaults to USER)
### (Note) Generic /auth/register removed - use role-specific endpoints below

###
# Auth - login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123"
}

###
# Role-specific registration endpoints

# Register as USER (alias) - multipart with file upload (photo)
POST {{host}}/auth/user/register

--file
Content-Disposition: form-data; name="photo"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg

--file
Content-Disposition: form-data; name="email"

user1@example.com

--file
Content-Disposition: form-data; name="password"

password123

--file
Content-Disposition: form-data; name="phone"

+93000000001

--file
Content-Disposition: form-data; name="firstName"

Noor

--file
Content-Disposition: form-data; name="lastName"

Azizi

--file
Content-Disposition: form-data; name="fullName"

Noor Azizi

--file
Content-Disposition: form-data; name="metadata"

{"preferredLanguage":"en"}

###
# Register as USER (JSON fallback) - useful if multipart client misbehaves
POST {{host}}/auth/user/register
Content-Type: application/json

{
  "email": "user1@example.com",
  "password": "password123",
  "phone": "+93000000001",
  "firstName": "Noor",
  "lastName": "Azizi",
  "fullName": "Noor Azizi",
  "metadata": {"preferredLanguage":"en"}
}


###
# Register as REPRESENTATIVE (public) - multipart with photo file
POST {{host}}/auth/representative/register

--file
Content-Disposition: form-data; name="photo"; filename="iphone.jpg"
Content-Type: image/jpeg

< ./fixtures/iphone.jpg

--file
Content-Disposition: form-data; name="email"

rep1@example.com

