###
# Admin - stats (shows retention days, scheduled times and queue job counts)
GET {{host}}/admin/stats
Authorization: Bearer {{adminToken}}
Content-Type: application/json

# Expected response (trimmed) - useful for frontend charting tests (Recharts-friendly shapes)
# {
#   "totals": { "total": 1234, "pending": 12, "approved": 1200 },
#   "retention": { "unapprovedDays": 2, "renewWindowDays": 14 },
#   "schedules": { "moderationCleanupTime": "03:00", "renewalCleanupTime": "06:00" },
#   "queueStats": { "moderation-cleanup": { "waiting": 0, "active": 0 }, "search-index": { "available": true } },
#   "summary": { "totalListings": 1234, "pendingListings": 12, "approvedListings": 1200, "totalUsers": 400, "feedbackCount": 150, "avgRating": 4.2 },
