# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES
# SQL is required. Redis and Elasticsearch are optional add-ons.
# On Vercel set HOSTING_PLATFORM=vercel (Redis/ES/Socket/queues forced off).
# ==============================================================================

HOSTING_PLATFORM=local
PORT=4000
NODE_ENV=development

# sqlite | mysql | postgresql
DB_PROVIDER=mysql
DATABASE_URL="mysql://root:password@localhost:3306/marketplace"
SQLITE_URL="file:./dev.db"

# Redis (optional). REDIS_ENABLED=false skips cache/queues even locally.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

# Elasticsearch (optional). Needs SEARCH_ENABLED=true AND a URL.
SEARCH_ENABLED=false
ENABLE_ELASTIC_SEARCH=false
ELASTICSEARCH_URL=
ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=listings
ELASTICSEARCH_USERS_INDEX=users
ELASTICSEARCH_BLOGS_INDEX=blogs
ELASTICSEARCH_ALLOW_SELF_SIGNED=true

SOCKET_IO_ENABLED=true
TOKEN_SECRET=change_this_token_secret_to_something_very_secure
JWT_SECRET=change_this_token_secret_to_something_very_secure
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@example.com"

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=

ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=
ADMIN_PASSWORD=MarketPlace@2026
SEED_USER_PASSWORD=MarketPlace@2026

LISTING_UNAPPROVED_DELETE_AFTER_DAYS=2
LISTING_RENEWAL_WINDOW_DAYS=14
DAILY_LISTING_CLEANUP_TIME=03:00
DAILY_RENEWAL_REMINDER_TIME=06:00
BLOG_STORY_KEEP_DAYS=30
DAILY_BLOG_STORY_CLEANUP_TIME=04:00
DAILY_STATUS_CLEANUP_TIME=02:00
SOLD_RENTED_CLEANUP_DAYS=90
DRAFT_CLEANUP_DAYS=30
DAILY_RENEWAL_EXPIRE_TIME=01:00
DAILY_FEEDBACK_REMINDER_TIME=08:00
FEEDBACK_REMINDER_DAYS=7
DAILY_BLOG_EXPIRY_CHECK_TIME=05:00
BLOG_DEFAULT_EXPIRY_DAYS=90
NOTIFY_BLOG_OWNER_TO_RENEW_DAYS=7

CRON_SECRET=
# BLOB_READ_WRITE_TOKEN=

RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
