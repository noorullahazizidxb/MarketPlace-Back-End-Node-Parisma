# Database (used by Prisma)
DATABASE_URL="mysql://root:Mcitp@123@localhost:3306/marketplace"

# Redis (BullMQ + caching)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=sys
# Elasticsearch
ELASTICSEARCH_NODE=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=Mcitp@123
ELASTICSEARCH_INDEX=listings
ELASTICSEARCH_ALLOW_SELF_SIGNED=true

# App
PORT=4000
NODE_ENV=development
TOKEN_SECRET=change_me

# Notifications (optional adapters)
# SMTP_* enables email notifications when set
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@example.com"

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=

# Admin seed (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=
ADMIN_PASSWORD=ChangeMe123!

# Jobs / retention periods (days)
UNAPPROVED_RETENTION_DAYS=2
RENEW_WINDOW_DAYS=14

# Scheduled times for recurring jobs (HH:mm 24-hour)
MODERATION_CLEANUP_TIME=03:00
# Reused for daily renewal reminders
RENEWAL_CLEANUP_TIME=06:00
