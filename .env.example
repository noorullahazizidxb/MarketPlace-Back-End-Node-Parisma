# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES BLUEPRINT
# ==============================================================================

# Application Setup
PORT=4000
NODE_ENV=development

# Database (Prisma)
DATABASE_URL="mysql://root:Mcitp@123@localhost:3306/marketplace"

# Redis (Caching & BullMQ)
REDIS_URL=redis://localhost:6379

# Elasticsearch Configuration
ENABLE-ELASTIC-SEARCH=true
ELASTICSEARCH_NODE=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=Mcitp@123
ELASTICSEARCH_INDEX=listings
ELASTICSEARCH_USERS_INDEX=users
ELASTICSEARCH_BLOGS_INDEX=blogs
ELASTICSEARCH_ALLOW_SELF_SIGNED=true

# Security & Auth Tokens
TOKEN_SECRET=change_this_token_secret_to_something_very_secure

# Global Origin
FRONTEND_URL=http://localhost:3000

# Social Auth Integrations
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
FACEBOOK_APP_ID=replace-with-facebook-app-id
FACEBOOK_APP_SECRET=replace-with-facebook-app-secret

# Email / SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@example.com"

# SMS / WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=

# Admin User Defaults (Seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=
ADMIN_PASSWORD=ChangeMe123!

# Periodic Jobs & Retention Options (Days/Times)
# Listing moderation cleanup
LISTING_UNAPPROVED_DELETE_AFTER_DAYS=2
LISTING_RENEWAL_WINDOW_DAYS=14
DAILY_LISTING_CLEANUP_TIME=03:00
DAILY_RENEWAL_REMINDER_TIME=06:00

# Blog & story content retention
BLOG_STORY_KEEP_DAYS=30
DAILY_BLOG_STORY_CLEANUP_TIME=04:00
SEED_CLEANUP_OLDER_THAN_DAYS=45

# Status cleanup (SOLD/RENTED/EXPIRED/DRAFT listing auto-deletion)
DAILY_STATUS_CLEANUP_TIME=02:00
SOLD_RENTED_CLEANUP_DAYS=90
DRAFT_CLEANUP_DAYS=30

# Renewal token expiry (marks listings EXPIRED when token expires)
DAILY_RENEWAL_EXPIRE_TIME=01:00

# Feedback reminder (days after sold/rented to send feedback request)
DAILY_FEEDBACK_REMINDER_TIME=08:00
FEEDBACK_REMINDER_DAYS=7

# Blog expiry lifecycle
DAILY_BLOG_EXPIRY_CHECK_TIME=05:00
BLOG_DEFAULT_EXPIRY_DAYS=90
NOTIFY_BLOG_OWNER_TO_RENEW_DAYS=7

# Realtime WebSocket URLs
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
