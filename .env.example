# Database
DATABASE_URL="mysql://root:Mcitp@123@localhost:3306/marketplace"

# Redis (BullMQ + caching)
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_NODE=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=Mcitp@123
ELASTICSEARCH_INDEX=listings
ELASTICSEARCH_ALLOW_SELF_SIGNED=true
# App
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
PLATFORM_CONTACT_WHATSAPP=+93xxxxxxxxx
PLATFORM_CONTACT_EMAIL=info@example.com
PLATFORM_CONTACT_PHONE=+93yyyyyyyyy
