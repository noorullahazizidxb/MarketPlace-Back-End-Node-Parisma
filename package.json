{
  "name": "af-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace + rentals platform with moderation, representatives, BullMQ jobs, Elasticsearch, notifications (Afghanistan context)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "reindex:all": "node scripts/reindex-search.js",
    "reindex:blogs": "node scripts/reindex-blogs.js",
    "init:users-index": "node scripts/initUsersIndex.js",
    "seed:all": "node scripts/seedAll.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "check:services": "node -r dotenv/config scripts/checkServices.js",
    "deploy": "bash ./deployment/deploy.sh ./deployment/.env",
    "fresh-deployment": "bash ./deployment/fresh-deployment.sh ./deployment/.env",
    "deploy:ps": "powershell -ExecutionPolicy Bypass -File ./deployment/deploy.ps1 -EnvFile ./deployment/.env",
    "fresh-deployment:ps": "powershell -ExecutionPolicy Bypass -File ./deployment/fresh-deployment.ps1 -EnvFile ./deployment/.env"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.13.0",
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "bullmq": "^5.58.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.2.0",
    "mysql2": "^3.11.0",
    "nanoid": "^5.1.5",
    "nodemailer": "9.0.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "rate-limit-redis": "^4.2.2",
    "sharp": "0.35.3",
    "socket.io": "^4.8.1",
    "twilio": "^4.9.0"
  },
  "optionalDependencies": {
    "express-rate-limit": "^6.11.2",
    "lru-cache": "^10.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "brace-expansion": "file:vendor/brace-expansion-compat",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "globals": "17.8.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.6",
    "prisma": "6.19.3"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion"
  }
}