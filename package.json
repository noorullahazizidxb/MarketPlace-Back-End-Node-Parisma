{
  "name": "af-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace + rentals platform with moderation, representatives, BullMQ jobs, Elasticsearch, notifications (Afghanistan context)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "prisma migrate dev",
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "reindex:all": "node scripts/reindex-search.js",
    "init:users-index": "node scripts/initUsersIndex.js",
    "seed:all": "node scripts/seedAll.js",
    "check:services": "node -r dotenv/config scripts/checkServices.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.13.0",
    "@prisma/client": "latest",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "bullmq": "^5.58.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "joi": "^17.12.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nanoid": "^5.1.5",
    "nodemailer": "^6.9.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "rate-limit-redis": "^4.2.2",
    "socket.io": "^4.8.1",
    "twilio": "^4.9.0"
  },
  "optionalDependencies": {
    "express-rate-limit": "^6.11.2",
    "lru-cache": "^10.4.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "prisma": "latest"
  }
}
