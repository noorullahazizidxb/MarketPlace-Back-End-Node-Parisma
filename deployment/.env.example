# Copy this file to deployment/.env and update secrets as needed.
# Use forward slashes for Windows paths.

DEPLOYMENT_DOCKERFILES_DIR=D:/MarketPlace/MarketPlace-Back-End-Node-Parisma/deployment/dockerfiles
