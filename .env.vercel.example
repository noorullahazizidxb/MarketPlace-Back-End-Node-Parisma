# Vercel (and similar serverless hosts).
# Use hosted PostgreSQL (Neon, Supabase, or Vercel Postgres). SQLite will not persist.
# Uploads require S3-compatible storage (AWS S3, Cloudflare R2, or equivalent).
# Scheduled work is HTTP cron (vercel.json), not in-process BullMQ.

APP_RUNTIME=serverless
DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://user:password@host/marketplace?sslmode=require"
DATABASE_DIRECT_URL="postgresql://user:password@host/marketplace?sslmode=require"

ENABLE_WORKERS=false
ENABLE_WEBSOCKETS=false
ENABLE_ELASTIC_SEARCH=false
STORAGE_DRIVER=s3
S3_BUCKET=your-bucket
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_FORCE_PATH_STYLE=true

TOKEN_SECRET=change_this_token_secret_to_something_very_secure
CRON_SECRET=change_this_cron_secret

NODE_ENV=production
