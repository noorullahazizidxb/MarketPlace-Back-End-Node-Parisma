# Paste these into the Vercel backend project. Same values as examples/vercel-free.env.example.
# SQLite files will not persist on Vercel. Use hosted Postgres (Neon recommended).

HOSTING_PLATFORM=vercel
NODE_ENV=production
DB_PROVIDER=postgresql
# Pooled Neon host (contains "-pooler"). Used by the serverless API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/marketplace?sslmode=require
# Direct Neon host (no "-pooler"). Used by prisma migrate deploy.
DIRECT_URL=postgresql://USER:PASSWORD@HOST/marketplace?sslmode=require

TOKEN_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=https://marketplace.devminds.net
FRONTEND_URL=https://marketplace.devminds.net

REDIS_ENABLED=false
SEARCH_ENABLED=false
ENABLE_ELASTIC_SEARCH=false
SOCKET_IO_ENABLED=false

CRON_SECRET=replace-with-a-random-cron-secret

# Optional: persistent file uploads
# BLOB_READ_WRITE_TOKEN=

JSON_LIMIT=10mb
URLENCODED_LIMIT=10mb
GOOGLE_CLIENT_ID=31499082252-m5fqgaeur47qrkau3fhcl9dmtsd1m6lr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=1431416712518258
FACEBOOK_APP_SECRET=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
