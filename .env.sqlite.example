# Local SQLite. Copy to .env
# Matches examples/local.env.example and npm run setup:defaults.

HOSTING_PLATFORM=local
PORT=4000
NODE_ENV=development

DB_PROVIDER=sqlite
SQLITE_URL="file:./dev.db"

REDIS_ENABLED=false
SEARCH_ENABLED=false
ENABLE_ELASTIC_SEARCH=false
SOCKET_IO_ENABLED=true

TOKEN_SECRET=replace-me
JWT_SECRET=replace-me
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_PHONE=
GOOGLE_CLIENT_ID=31499082252-m5fqgaeur47qrkau3fhcl9dmtsd1m6lr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=1431416712518258
FACEBOOK_APP_SECRET=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
