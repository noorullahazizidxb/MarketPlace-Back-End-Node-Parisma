# ── SQLite local development ─────────────────────────────────────────────────
# Copy this file to .env to use SQLite for local development.
# SQLite requires NO database server — the file is created automatically.

DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
JWT_SECRET=your-local-dev-secret-change-in-production

# Admin seed credentials (run: node scripts/seedAdmin.js)
ADMIN_EMAIL=noorullah.azizi2040@gmail.com
ADMIN_PASSWORD=Mcitp@123
ADMIN_PHONE=+93700000001

# Optional: Redis (caching / queues) — can be omitted in SQLite dev mode
# REDIS_URL=redis://localhost:6379
