# SQLite for local development or a single host with a persistent disk.
# Copy this file to .env. SQLite does not need a database server.
# Do not use SQLite when APP_RUNTIME=serverless (Vercel). The filesystem there is ephemeral.

DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
APP_RUNTIME=server
ENABLE_WORKERS=true
ENABLE_WEBSOCKETS=true
STORAGE_DRIVER=local
ENABLE_ELASTIC_SEARCH=false

NODE_ENV=development
PORT=3002
TOKEN_SECRET=your-local-dev-secret-change-in-production

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=

# Optional. Leave unset to skip Redis; set ENABLE_WORKERS=false to run without BullMQ.
# REDIS_URL=redis://localhost:6379
