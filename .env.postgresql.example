# PostgreSQL for a long-running host (VPS, Render, Railway, Fly) or any always-on Node process.
# Copy to .env and point DATABASE_URL at your Postgres instance.

DATABASE_PROVIDER=postgresql
DATABASE_URL="postgresql://user:password@localhost:5432/marketplace"
# Unpooled URL used by Prisma migrations when DATABASE_URL goes through PgBouncer / Neon pooler.
# DATABASE_DIRECT_URL="postgresql://user:password@localhost:5432/marketplace"

APP_RUNTIME=server
ENABLE_WORKERS=true
ENABLE_WEBSOCKETS=true
STORAGE_DRIVER=local
ENABLE_ELASTIC_SEARCH=false

NODE_ENV=development
PORT=4000
TOKEN_SECRET=change_this_token_secret_to_something_very_secure

REDIS_URL=redis://localhost:6379

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=
