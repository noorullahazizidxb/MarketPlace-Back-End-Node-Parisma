# PostgreSQL for a long-running host (VPS) or any always-on Node process.
# Copy to .env. For Neon, use examples/neon.env.example instead.

HOSTING_PLATFORM=vps
NODE_ENV=production
PORT=4000

DB_PROVIDER=postgresql
DATABASE_URL="postgresql://user:replace-me@localhost:5432/marketplace"
DIRECT_URL="postgresql://user:replace-me@localhost:5432/marketplace"

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
SEARCH_ENABLED=false
ENABLE_ELASTIC_SEARCH=false
SOCKET_IO_ENABLED=true

TOKEN_SECRET=replace-me
JWT_SECRET=replace-me

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_PHONE=
