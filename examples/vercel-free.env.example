# Vercel Hobby. Paste into the backend project environment variables.
# HOSTING_PLATFORM=vercel forces Redis, Elasticsearch, Socket.IO, and queues off.
# Use Neon or another hosted Postgres. SQLite files do not persist on Vercel.
# No Blob token on the free plan.

HOSTING_PLATFORM=vercel
NODE_ENV=production
DB_PROVIDER=postgresql

DATABASE_URL=postgresql://USER:replace-me@HOST-pooler.region.aws.neon.tech/marketplace?sslmode=require
DIRECT_URL=postgresql://USER:replace-me@HOST.region.aws.neon.tech/marketplace?sslmode=require

TOKEN_SECRET=replace-me
JWT_SECRET=replace-me
CORS_ORIGIN=https://marketplace.devminds.net
FRONTEND_URL=https://marketplace.devminds.net

REDIS_ENABLED=false
SEARCH_ENABLED=false
ENABLE_ELASTIC_SEARCH=false
SOCKET_IO_ENABLED=false

JSON_LIMIT=10mb
URLENCODED_LIMIT=10mb
