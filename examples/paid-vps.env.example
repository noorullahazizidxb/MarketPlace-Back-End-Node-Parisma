# Paid VPS (Ubuntu or Docker). Copy to ../.env on the server.
# HOSTING_PLATFORM is not vercel, so Redis and Socket.IO stay available.
# Search stays off until SEARCH_ENABLED=true and ELASTICSEARCH_URL are both set.

HOSTING_PLATFORM=vps
PORT=4000
NODE_ENV=production

DB_PROVIDER=mysql
DATABASE_URL="mysql://root:replace-me@127.0.0.1:3306/marketplace"

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379

SEARCH_ENABLED=false
ENABLE_ELASTIC_SEARCH=false
ELASTICSEARCH_URL=
ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=listings
ELASTICSEARCH_USERS_INDEX=users
ELASTICSEARCH_BLOGS_INDEX=blogs

SOCKET_IO_ENABLED=true

TOKEN_SECRET=replace-me
JWT_SECRET=replace-me
CORS_ORIGIN=https://marketplace.devminds.net
FRONTEND_URL=https://marketplace.devminds.net

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_PHONE=

CRON_SECRET=replace-me
GOOGLE_CLIENT_ID=31499082252-m5fqgaeur47qrkau3fhcl9dmtsd1m6lr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=1431416712518258
FACEBOOK_APP_SECRET=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
