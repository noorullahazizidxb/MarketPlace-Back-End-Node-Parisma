# Neon Postgres. Merge these keys into the Vercel or VPS env.
# DATABASE_URL is the pooled host (the hostname contains "-pooler").
# DIRECT_URL is the unpooled host, used by prisma migrate deploy.

DB_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:replace-me@ep-example-pooler.region.aws.neon.tech/marketplace?sslmode=require
DIRECT_URL=postgresql://USER:replace-me@ep-example.region.aws.neon.tech/marketplace?sslmode=require
GOOGLE_CLIENT_ID=31499082252-m5fqgaeur47qrkau3fhcl9dmtsd1m6lr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=1431416712518258
FACEBOOK_APP_SECRET=
