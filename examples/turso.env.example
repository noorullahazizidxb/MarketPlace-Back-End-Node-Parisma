# Turso (libSQL). This file is a reference, not a working config.
# prisma.config.ts only generates sqlite, mysql, or postgresql.
# A libsql:// URL will not connect until a libSQL driver is added.
# Until then, use examples/local.env.example (SQLite file).

# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=replace-me

DB_PROVIDER=sqlite
SQLITE_URL="file:./dev.db"
GOOGLE_CLIENT_ID=31499082252-m5fqgaeur47qrkau3fhcl9dmtsd1m6lr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=1431416712518258
FACEBOOK_APP_SECRET=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
