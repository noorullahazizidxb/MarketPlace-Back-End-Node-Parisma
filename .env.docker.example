# ==============================================================================
#  docker/.env.docker.example  —  copy to .env.docker and fill in values
# ==============================================================================

# ─── Runtime ─────────────────────────────────────────────────────────────────
HOSTING_PLATFORM=vps
NODE_ENV=production
PORT=4000
DB_PROVIDER=mysql

# ─── MySQL ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=replace-me
DATABASE_URL="mysql://root:replace-me@mysql:3306/marketplace"

# ─── Auth ────────────────────────────────────────────────────────────────────
TOKEN_SECRET=replace-me
JWT_SECRET=replace-me
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
SEARCH_ENABLED=false
SOCKET_IO_ENABLED=true

# ─── Admin seed credentials ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
ADMIN_PHONE=

# ─── SMTP ────────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@devminds.net

# ─── Twilio / WhatsApp ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=

# ─── Social Auth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Elasticsearch (optional) ────────────────────────────────────────────────
ENABLE_ELASTIC_SEARCH=false
ELASTICSEARCH_NODE=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=listings
ELASTICSEARCH_USERS_INDEX=users
ELASTICSEARCH_BLOGS_INDEX=blogs
ELASTICSEARCH_ALLOW_SELF_SIGNED=true

# ─── Frontend build args ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=https://api.devminds.net/api
NEXT_PUBLIC_API_BASE_URL=https://api.devminds.net/api
NEXT_PUBLIC_WS_URL=https://api.devminds.net
NEXT_PUBLIC_SOCKET_URL=https://api.devminds.net
NEXT_PUBLIC_ENABLE_ELASTIC_SEARCH=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_GOOGLE_AUTH_URL=
NEXT_PUBLIC_FACEBOOK_AUTH_URL=
# Google reCAPTCHA v3 site key (public)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Google reCAPTCHA v3 secret (server-side siteverify — never expose to browsers)
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ─── Frontend git source ─────────────────────────────────────────────────────
FRONTEND_REPO_URL=https://github.com/noorullahazizidxb/MarketPlace-Next-JS.git
FRONTEND_REPO_REF=main

# ─── Origin config ───────────────────────────────────────────────────────────
FRONTEND_URL=https://marketplace.devminds.net
BLOG_ORIGIN=
MARKETPLACE_ORIGIN=https://marketplace.devminds.net
